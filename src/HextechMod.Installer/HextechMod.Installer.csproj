<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 目标 .NET Framework 4.8：Win10 1903+ / Win11 全部自带，玩家不用另装运行时。
         用 net8 自包含发布的话包体要一百多兆，一个安装器没必要那么重。 -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>HextechModInstaller</AssemblyName>
    <RootNamespace>PeakModder.HextechInstaller</RootNamespace>
    <AssemblyTitle>小王同学模组安装器</AssemblyTitle>
    <Product>HextechMod</Product>
    <!-- 安装器版本只在自身代码有改动、要重发一次 exe 时才手动往上抬；
         发布脚本不再每次发版都动它（安装器已经能云更，不必跟着模组一起发）。
         1.2.0：双页改造 —— 主页只管 BepInEx 框架，新增「模组仓库」页（version.json + repository.json）。
         1.3.0：磨砂白浅色界面 + 左侧导航三页（主页作者卡 / 前置框架 / 模组仓库）；修仓库卡片漏挂 Child。
         1.3.1：前置框架页删掉「卸载时一并移除框架」勾选框（该页只管框架，卸载按钮直接卸框架）。
         1.3.2：全界面圆角放大（窗口 22 / 卡片 18 / 按钮 16 / 日志框套圆角 / 进度条胶囊），主页指引精简。
         1.3.3：修 QQ 头像永远显示占位 —— 构造函数里开跑的 async 会落在无同步上下文的线程池线程上，
         给 Image.Source 赋值跨线程爆炸；挪到 OnLoaded，抓取解码后台线程 + Freeze + Dispatcher 更新。
         1.3.4：应用图标（用户提供的绿山 Logo，圆角处理，exe 图标走 ApplicationIcon、窗口图标内嵌 app.ico）
         + 主窗口内启动加载页（开源库 LoadingIndicators.WPF 的旋转弧动画，加载完淡出露出主界面）。 -->
    <Version>1.3.4</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>PeakModder.HextechInstaller.Program</StartupObject>
    <!-- 安装器要往 Program Files 下的游戏目录里写文件，直接申请管理员权限，省得装到一半才失败。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- net48 走的是 .NET Framework 的分析器规则，本机不一定装齐，关掉免得刷一屏噪音警告。 -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 下 SDK 不会自动带上 WPF；界面是纯代码搭的（没有 .xaml），手动引这几个就够。 -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- 本机没装 .NET Framework 4.8 开发包时，从 NuGet 还原引用程序集。 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- 开源控件库（MIT）：启动加载页的 ProgressRing 旋转动画。 -->
    <PackageReference Include="MahApps.Metro" Version="1.6.5" />
    <!-- MahApps 1.6.5 的运行时依赖（ThemeManager / 颜色资源）。 -->
    <PackageReference Include="ControlzEx" Version="3.0.2.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 窗口图标：ico 同时是 exe 图标（ApplicationIcon）。圆角裁切脚本：_tools/make-installer-icon.ps1。 -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 先建 mod 再建安装器：发布脚本一次构建就要拿到两边的产物。
         SkipGetTargetFrameworkProperties 是为了绕开 net48 ↔ netstandard2.1 的兼容性检查 ——
         这里只是要构建顺序，不真的引用它的程序集。
         注意：安装器不再把 mod dll 嵌进 exe 了，模组本体一律从服务器下载（见 InstallEngine）。 -->
    <ProjectReference
      Include="../HextechMod/HextechMod.csproj"
      ReferenceOutputAssembly="false"
      SkipGetTargetFrameworkProperties="true"
      Private="false"
    />
  </ItemGroup>

</Project>
