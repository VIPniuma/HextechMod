<Project Sdk="Microsoft.NET.Sdk">
  <!-- Project properties -->
  <PropertyGroup>
    <!-- This is the most appropriate target framework for the game's Unity version. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- This is the global identifier for your mod. This should not be changed after release. -->
    <AssemblyName>PeakModder.HextechMod</AssemblyName>
    <!-- This is the display name of your mod. -->
    <AssemblyTitle>HextechMod</AssemblyTitle>
    <!-- The version number for your assembly, BepInEx plugin, and Thunderstore package. -->
    <Version>0.3.86</Version>
    <RootNamespace>PeakModder.HextechMod</RootNamespace>
  </PropertyGroup>

  <!--
    Define mod files to copy to the relative BepInEx directory after build.
    （不再打包/上传雷霆商店：ThunderPipe 打包配置已于 2026-09-16 移除，只保留本地部署。）
  -->
  <ItemGroup>
    <ModFile Include="$(TargetPath)" Destination="plugins/" />
  </ItemGroup>

  <!-- 技能图标：game-icons.net（CC BY 3.0），构建时嵌入 dll，保持单文件分发。 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Icons\*.png" />
  </ItemGroup>
</Project>
